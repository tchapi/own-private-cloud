###############################################################
#                   Authelia configuration                    #
###############################################################

theme: 'auto'

log:
  level: info

totp:
  issuer: $AUTH_DOMAIN

authentication_backend:
  password_reset:
    disable: true
  file:
    path: /config/users_database.yml

access_control:
  default_policy: one_factor

session:
  secret: $OIDC_SESSION_SECRET
  cookies:
    - name: 'authelia_session'
      domain: $TOP_DOMAIN
      authelia_url: https://$AUTH_DOMAIN
      remember_me: 1M
      expiration: 1M
      inactivity: 1M
      default_redirection_url: https://$TOP_DOMAIN

regulation:
  max_retries: 3
  find_time: 120
  ban_time: 600

storage:
  encryption_key: $OIDC_STORAGE_ENCRYPTION_KEY
  local:
    path: /data/db.sqlite3

notifier:
  smtp:
    username: no-reply@$TOP_DOMAIN
    password: $MAIL_NO_REPLY_PASSWORD
    address: submission://$MAIL_DOMAIN:$MAIL_PORT
    sender: no-reply@$TOP_DOMAIN

##
## Identity Providers
##
identity_providers:
  oidc:
    hmac_secret: $OIDC_HMAC_SECRET
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
          $OIDC_ISSUER_PRIVATE_KEY
    # access_token_lifespan: 1M
    # id_token_lifespan: 1h
    # refresh_token_lifespan: 1M1h
    clients:
    - client_id: outline
      client_name: Outline
      client_secret: "$OUTLINE_OIDC_HASHED_CLIENT_SECRET"
      public: false
      authorization_policy: one_factor
      redirect_uris:
        - https://$NOTES_DOMAIN/auth/oidc.callback
      scopes:
        - openid
        - profile
        - email
      userinfo_signed_response_alg: none
      consent_mode: 'pre-configured'
      pre_configured_consent_duration: 1y
      token_endpoint_auth_method: 'client_secret_post'
